pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Writes the Hyprland settings that System Settings controls (displays,
// keyboard) to ~/.config/foxtail/hypr/generated.lua, which foxtail.lua loads,
// and reloads Hyprland when it changes. Keeping them in a file means they
// apply from the first frame of the next login, not just live.
Singleton {
    id: root

    readonly property string path: Quickshell.env("HOME") + "/.config/foxtail/hypr/generated.lua"

    function q(s) { return '"' + String(s).replace(/["\\]/g, "") + '"'; }

    readonly property string text: {
        const lines = ["-- Generated by Foxtail System Settings. Changes made here are overwritten.", ""];
        const layouts = Keyboard.layouts.join(",");
        lines.push(`foxtail_layouts = ${q(layouts)}`);
        lines.push(`foxtail_layout_shortcut = ${Settings.layoutSwitchShortcut}`);
        lines.push(`hl.config({ input = { kb_layout = ${q(layouts)}, repeat_delay = ${Math.round(Settings.keyRepeatDelay)}, repeat_rate = ${Math.round(Settings.keyRepeatRate)} } })`);
        const d = Settings.displays;
        for (const name of Object.keys(d).sort()) {
            const c = d[name];
            if (c.disabled) {
                lines.push(`hl.monitor({ output = ${q(name)}, disabled = true })`);
                continue;
            }
            const parts = [`output = ${q(name)}`, `mode = ${q(c.mode)}`,
                           `position = ${q(Math.round(c.x) + "x" + Math.round(c.y))}`, `scale = ${c.scale}`];
            if (c.transform) parts.push(`transform = ${c.transform}`);
            if (c.mirror) parts.push(`mirror = ${q(c.mirror)}`);
            lines.push(`hl.monitor({ ${parts.join(", ")} })`);
        }
        return lines.join("\n") + "\n";
    }

    property bool loaded: false
    Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", Quickshell.env("HOME") + "/.config/foxtail/hypr"])

    FileView {
        id: file
        path: root.path
        blockLoading: true
        printErrors: false
        onLoaded: root.loaded = true
        onLoadFailed: root.loaded = true
    }

    onTextChanged: if (loaded) writeSoon.restart()
    onLoadedChanged: if (loaded && file.text() !== text) writeSoon.restart()

    Timer {
        id: writeSoon
        interval: 400
        onTriggered: {
            if (file.text() === root.text) return;
            file.setText(root.text);
            reload.restart();
        }
    }
    Timer {
        id: reload
        interval: 200
        onTriggered: Quickshell.execDetached(["hyprctl", "reload"])
    }
}
