#!/bin/sh
# Session entry point (wayland-sessions/foxtail.desktop).
cfg="$HOME/.config/hypr/hyprland.lua"
if [ ! -f "$cfg" ]; then
    mkdir -p "$(dirname "$cfg")"
    cp /etc/skel/.config/hypr/hyprland.lua "$cfg"
fi

# VirtualBox/VMware's vmwgfx GPU: hardware EGL either fails outright (no 3D)
# or stalls page flips (3D on). Mesa's software renderer works reliably.
if [ -d /sys/module/vmwgfx ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export FOXTAIL_SOFTWARE_RENDERING=1
fi

exec start-hyprland
