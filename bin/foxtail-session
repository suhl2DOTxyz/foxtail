#!/bin/sh
# Session entry point (wayland-sessions/foxtail.desktop).
cfg="$HOME/.config/hypr/hyprland.lua"
if [ ! -f "$cfg" ]; then
    mkdir -p "$(dirname "$cfg")"
    cp /etc/skel/.config/hypr/hyprland.lua "$cfg"
fi

# VirtualBox/VMware's vmwgfx GPU: without 3D, hardware EGL fails outright;
# with 3D on, Mesa's SVGA driver can't create Qt's EGL surfaces (tested on
# VirtualBox 7.2: black screen). Mesa's software renderer works reliably.
# `touch /etc/foxtail/try-hw` to test hardware rendering on a newer VM stack.
if [ -d /sys/module/vmwgfx ] && [ ! -e /etc/foxtail/try-hw ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export FOXTAIL_SOFTWARE_RENDERING=1
fi

exec start-hyprland
