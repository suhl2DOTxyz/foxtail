#!/bin/sh
# foxtail-screenshot <screen|area|window|pick-window> [--delay N] [--pointer]
#                    [--dir DIR | --clipboard]
#   screen       the display the pointer is on
#   area         drag out a region
#   window       the focused window
#   pick-window  click a window
# Saves "Screenshot <date> at <time>.png" to DIR (default: the Desktop, as on
# macOS) and prints its path, or with --clipboard copies the picture instead.
# Exits 3 if the selection was cancelled.
mode=${1:-screen}; shift
delay=0; pointer=""; dir=""; clip=""
while [ $# -gt 0 ]; do
    case "$1" in
        --delay) delay=$2; shift ;;
        --pointer) pointer=-c ;;
        --dir) dir=$2; shift ;;
        --clipboard) clip=1 ;;
    esac
    shift
done

[ -n "$dir" ] || dir="$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")"
mkdir -p "$dir"

windows() {   # geometry of every visible window on the active desktops, for slurp -r
    hyprctl -j monitors | jq -r '.[].activeWorkspace.id' > "/tmp/.ft-ws.$$"
    hyprctl -j clients | jq -r --slurpfile ws "/tmp/.ft-ws.$$" \
        '.[] | select(.workspace.id as $w | any($ws[]; . == $w)) | select(.hidden | not) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
    rm -f "/tmp/.ft-ws.$$"
}

case "$mode" in
    area)        geom=$(slurp -d -b '#00000040' -c '#FF7A1AFF' -w 2) || exit 3 ;;
    pick-window) geom=$(windows | slurp -r -b '#00000030' -c '#FF7A1AFF' -B '#FF7A1A30' -w 3) || exit 3 ;;
    window)      geom=$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"') ;;
    *)           output=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name') ;;
esac

[ "$delay" -gt 0 ] 2>/dev/null && sleep "$delay"
sleep 0.15   # let menus and the toolbar fade out first

if [ -n "$clip" ]; then
    file=$(mktemp --suffix=.png)
else
    file="$dir/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"
fi
if [ -n "${geom:-}" ]; then
    grim $pointer -g "$geom" "$file"
elif [ -n "${output:-}" ]; then
    grim $pointer -o "$output" "$file"
else
    grim $pointer "$file"
fi || exit 1

if [ -n "$clip" ]; then
    wl-copy --type image/png < "$file"
    rm -f "$file"
else
    echo "$file"
fi
