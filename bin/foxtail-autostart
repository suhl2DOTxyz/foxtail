#!/bin/sh
# Start the user's login items (~/.config/autostart/*.desktop), the way
# desktop environments do: skips Hidden=true entries and ones not meant for
# this desktop, and strips the %f/%u style field codes from Exec.
dir="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
[ -d "$dir" ] || exit 0
for f in "$dir"/*.desktop; do
    [ -f "$f" ] || continue
    grep -qiE '^Hidden=true' "$f" && continue
    only=$(grep -m1 '^OnlyShowIn=' "$f" | cut -d= -f2-)
    if [ -n "$only" ]; then
        echo "$only" | grep -qiE '(^|;)(Foxtail|Hyprland)(;|$)' || continue
    fi
    grep -m1 '^NotShowIn=' "$f" | grep -qiE '(=|;)(Foxtail|Hyprland)(;|$)' && continue
    cmd=$(grep -m1 '^Exec=' "$f" | cut -d= -f2- | sed -E 's/ ?%[fFuUdDnNickvm]//g')
    [ -n "$cmd" ] || continue
    setsid sh -c "$cmd" >/dev/null 2>&1 < /dev/null &
done
