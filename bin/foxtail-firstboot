#!/bin/sh
# Per-user first-login setup. Runs every login but only acts once.
stamp="$HOME/.config/foxtail/.firstboot-done"
mkdir -p "$HOME/.config/foxtail"

# Finder-style Favorites in the Files sidebar: Desktop, Documents, Downloads,
# Pictures, Music, Videos. Once per account (accounts made before 1.5 too),
# and never over bookmarks you already have.
if [ ! -f "$HOME/.config/foxtail/.favorites-done" ]; then
    xdg-user-dirs-update
    bm="$HOME/.config/gtk-3.0/bookmarks"
    if [ ! -s "$bm" ]; then
        mkdir -p "$(dirname "$bm")"
        for d in DESKTOP DOCUMENTS DOWNLOAD PICTURES MUSIC VIDEOS; do
            p=$(xdg-user-dir "$d")
            [ -d "$p" ] && [ "$p" != "$HOME" ] && printf 'file://%s\n' "$p" | sed 's/ /%20/g' >> "$bm"
        done
    fi
    touch "$HOME/.config/foxtail/.favorites-done"
fi

# macOS-sized text (13px, Inter 10pt) for apps. Accounts made before 1.8 had
# 11pt; move them over once, unless they picked a font of their own.
if [ ! -f "$HOME/.config/foxtail/.font13-done" ]; then
    for k in font-name document-font-name; do
        [ "$(gsettings get org.gnome.desktop.interface $k)" = "'Inter 11'" ] &&
            gsettings set org.gnome.desktop.interface $k 'Inter 10'
    done
    [ "$(gsettings get org.gnome.desktop.interface monospace-font-name)" = "'JetBrains Mono 11'" ] &&
        gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 10'
    ini="$HOME/.config/gtk-3.0/settings.ini"
    [ -f "$ini" ] && sed -i 's/^gtk-font-name=Inter 11$/gtk-font-name=Inter 10/' "$ini"
    touch "$HOME/.config/foxtail/.font13-done"
fi

# 2.1: Foxtail's own Terminal replaces Ptyxis; move a Ptyxis Dock icon over once.
if [ ! -f "$HOME/.config/foxtail/.terminal21-done" ]; then
    f="$HOME/.config/foxtail/settings.json"
    if [ -f "$f" ] && command -v jq >/dev/null; then
        jq 'if (.pinnedApps | type) == "array" then .pinnedApps |= map(if . == "org.gnome.Ptyxis" then "org.foxtail.Terminal" else . end) else . end' "$f" > "$f.tmp" &&
            mv "$f.tmp" "$f"
    fi
    touch "$HOME/.config/foxtail/.terminal21-done"
fi

[ -f "$stamp" ] && exit 0

# Window controls on the left, macOS order.
gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:'
gsettings set org.gnome.desktop.interface font-name 'Inter 10'
gsettings set org.gnome.desktop.interface document-font-name 'Inter 10'
gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 10'
gsettings set org.gnome.desktop.interface icon-theme 'WhiteSur'
gsettings set org.gnome.desktop.interface cursor-theme 'macOS'
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface font-antialiasing 'rgba'
gsettings set org.gnome.desktop.interface clock-format '12h'
gsettings set org.gtk.Settings.FileChooser sort-directories-first true
gsettings set org.gnome.nautilus.preferences default-folder-viewer 'icon-view' 2>/dev/null

xdg-user-dirs-update
mkdir -p "$HOME/Pictures/Screenshots" "$(xdg-user-dir DESKTOP)"

foxtail-sync-appearance light '#FF7A1A'

# Friendly welcome (give the shell a moment to start its notification server).
sleep 3
notify-send -a "Foxtail" -i foxtail "Welcome to Foxtail" \
    "Press ⌘ Space for Spotlight. Your Super key is ⌘. Open Control Center to try Liquid Glass."

touch "$stamp"

# Live ISO: open the installer after the desktop settles.
if [ "$USER" = liveuser ]; then
    sleep 4
    foxtail-ipc installer
fi
