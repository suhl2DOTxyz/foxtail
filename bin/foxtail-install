#!/usr/bin/env bash
# foxtail-install: install Foxtail from the live ISO to a disk (run as root).
#
# Reads settings from the environment:
#   FT_DISK=/dev/sda  FT_USER=fox  FT_FULLNAME="Fox Tail"  FT_HOST=foxtail
#   FT_TZ=Europe/Berlin  FT_LOCALE=en_US.UTF-8  FT_KEYMAP=us
# and the user's password on stdin (one line).
#
# Prints "PROGRESS <0-100> <message>" lines for the Setup app, and
# "ERROR <message>" on failure. ERASES FT_DISK ENTIRELY.
#
# Layout: GPT with an EFI partition (mounted at /efi) and one Btrfs
# partition with subvolumes @ (/), @home, @snapshots (/.snapshots), @log and
# @pkg. Kernels live in /boot inside @, so every snapshot is bootable with
# the kernel it was taken with: GRUB + grub-btrfs list them, snapper +
# snap-pac take one before and after every update.
set -Eeuo pipefail

progress() { echo "PROGRESS $1 $2"; }
fail() { echo "ERROR $*"; exit 1; }
trap 'fail "Step failed at line $LINENO: $BASH_COMMAND"' ERR

[ "$(id -u)" -eq 0 ] || fail "must run as root"
: "${FT_DISK:?}" "${FT_USER:?}" "${FT_HOST:=foxtail}" "${FT_TZ:=UTC}" "${FT_LOCALE:=en_US.UTF-8}" "${FT_KEYMAP:=us}"
FT_FULLNAME="${FT_FULLNAME:-$FT_USER}"
[[ "$FT_USER" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "invalid user name"
[[ "$FT_HOST" =~ ^[A-Za-z0-9-]{1,63}$ ]] || fail "invalid computer name"
[ -b "$FT_DISK" ] || fail "$FT_DISK is not a block device"
IFS= read -r FT_PASS || true
[ -n "$FT_PASS" ] || fail "empty password"

BOOTMNT=/run/archiso/bootmnt
SFS=$(find "$BOOTMNT/arch" -name airootfs.sfs | head -1)
[ -f "$SFS" ] || fail "live image not found (are you running the Foxtail live ISO?)"
TARGET=/mnt/foxtail

# Partition names: /dev/sda1 vs /dev/nvme0n1p1
part() { if [[ "$FT_DISK" =~ [0-9]$ ]]; then echo "${FT_DISK}p$1"; else echo "${FT_DISK}$1"; fi; }

progress 2 "Preparing disk…"
umount -R "$TARGET" 2>/dev/null || true
swapoff -a || true
wipefs -af "$FT_DISK"
sgdisk --zap-all "$FT_DISK"
sgdisk -n1:0:+512M -t1:ef00 -c1:EFI -n2:0:0 -t2:8304 -c2:Foxtail "$FT_DISK"
partprobe "$FT_DISK"
udevadm settle
ESP=$(part 1)
ROOT=$(part 2)

progress 6 "Formatting…"
mkfs.fat -F32 -n EFI "$ESP"
mkfs.btrfs -f -L Foxtail "$ROOT"
mkdir -p "$TARGET"
mount "$ROOT" "$TARGET"
for sv in @ @home @snapshots @log @pkg; do btrfs subvolume create "$TARGET/$sv" >/dev/null; done
umount "$TARGET"

OPTS=noatime,compress=zstd:1,space_cache=v2
mount -o "$OPTS,subvol=@" "$ROOT" "$TARGET"
mkdir -p "$TARGET"/{home,.snapshots,var/log,var/cache/pacman/pkg,efi}
mount -o "$OPTS,subvol=@home" "$ROOT" "$TARGET/home"
mount -o "$OPTS,subvol=@snapshots" "$ROOT" "$TARGET/.snapshots"
mount -o "$OPTS,subvol=@log" "$ROOT" "$TARGET/var/log"
mount -o "$OPTS,subvol=@pkg" "$ROOT" "$TARGET/var/cache/pacman/pkg"
mount -o fmask=0077,dmask=0077 "$ESP" "$TARGET/efi"

progress 10 "Copying Foxtail…"
# -percentage prints one number per line; map it onto 10-80%.
unsquashfs -percentage -f -d "$TARGET" "$SFS" | while IFS= read -r pct; do
    if [[ "$pct" =~ ^[0-9]+$ ]]; then progress $((10 + pct * 70 / 100)) "Copying Foxtail…"; fi
done

progress 81 "Installing kernel…"
mkdir -p "$TARGET/boot"
if [ ! -f "$TARGET/boot/vmlinuz-linux" ]; then
    cp "$BOOTMNT/arch/boot/x86_64/vmlinuz-linux" "$TARGET/boot/"
fi
for ucode in intel-ucode.img amd-ucode.img; do
    [ -f "$BOOTMNT/boot/$ucode" ] && cp "$BOOTMNT/boot/$ucode" "$TARGET/boot/" || true
done

progress 84 "Removing live-session settings…"
rm -f "$TARGET/etc/mkinitcpio.conf.d/archiso.conf" \
      "$TARGET/etc/systemd/system/foxtail-live-user.service" \
      "$TARGET/etc/systemd/system/multi-user.target.wants/foxtail-live-user.service" \
      "$TARGET/etc/sddm.conf.d/10-live-autologin.conf" \
      "$TARGET/etc/sudoers.d/10-live" \
      "$TARGET/etc/polkit-1/rules.d/49-foxtail-live.rules" \
      "$TARGET/usr/share/applications/foxtail-installer.desktop" \
      "$TARGET/etc/systemd/system/getty@tty1.service.d/autologin.conf"
rm -f "$TARGET/etc/machine-id"
# The live mkinitcpio preset points at archiso's config; restore the stock one.
cat > "$TARGET/etc/mkinitcpio.d/linux.preset" <<'EOF'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

genfstab -U "$TARGET" > "$TARGET/etc/fstab"

progress 87 "Configuring your system…"
arch-chroot "$TARGET" /bin/bash -e <<CHROOT
systemd-machine-id-setup >/dev/null
userdel -r liveuser 2>/dev/null || true

ln -sf "/usr/share/zoneinfo/$FT_TZ" /etc/localtime
hwclock --systohc || true
sed -i "s/^#\\($FT_LOCALE.*\\)/\\1/" /etc/locale.gen
grep -q "^$FT_LOCALE" /etc/locale.gen || echo "$FT_LOCALE UTF-8" >> /etc/locale.gen
locale-gen >/dev/null
echo "LANG=$FT_LOCALE" > /etc/locale.conf
echo "KEYMAP=$FT_KEYMAP" > /etc/vconsole.conf
echo "$FT_HOST" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1 localhost
::1       localhost
127.0.1.1 $FT_HOST.localdomain $FT_HOST
EOF

useradd -m -G wheel,audio,video,input,network -s /bin/bash -c "$FT_FULLNAME" "$FT_USER"
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# Package trust: Arch's keys plus the Foxtail signing key, and Foxtail's own
# repository for updates (signatures required).
pacman-key --init >/dev/null 2>&1
pacman-key --populate archlinux foxtail >/dev/null 2>&1
grep -q '^\[foxtail\]' /etc/pacman.conf || cat >> /etc/pacman.conf <<'EOF'

# Foxtail updates (shell, themes, branding). Signed with the Foxtail key.
[foxtail]
SigLevel = Required
Server = https://github.com/suhl2DOTxyz/foxtail/releases/download/repo
EOF

# Snapshots: snapper's config for /, stored on the @snapshots subvolume that
# is already mounted at /.snapshots (so no nested .snapshots subvolume).
# The template is copied by hand because snapper's create-config insists on making
# its own subvolume there.
cp /usr/share/snapper/config-templates/default /etc/snapper/configs/root
sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' /etc/conf.d/snapper 2>/dev/null \
    || echo 'SNAPPER_CONFIGS="root"' > /etc/conf.d/snapper
sed -i -e 's|^SUBVOLUME=.*|SUBVOLUME="/"|' \
       -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
       -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
       -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
       -e 's/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' /etc/snapper/configs/root
chmod 750 /.snapshots
sed -i 's/^#\?GRUB_BTRFS_SUBMENUNAME=.*/GRUB_BTRFS_SUBMENUNAME="Foxtail snapshots"/' /etc/default/grub-btrfs/config 2>/dev/null || true

mkinitcpio -P >/dev/null

# Boot: GRUB, menu hidden unless Esc/Shift is held (snapshots live there).
sed -i -e 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Foxtail"/' \
       -e 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' \
       -e 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' \
       -e 's|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0"|' \
       -e 's|^#\?GRUB_THEME=.*|GRUB_THEME="/usr/share/grub/themes/foxtail/theme.txt"|' \
       -e 's/^GRUB_GFXMODE=.*/GRUB_GFXMODE=auto/' /etc/default/grub
grub-install --target=x86_64-efi --efi-directory=/efi --bootloader-id=Foxtail >/dev/null 2>&1 || true
# Also install to the fallback path, for firmware (and VMs) that forget boot entries.
grub-install --target=x86_64-efi --efi-directory=/efi --removable >/dev/null
grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1

snapper --no-dbus -c root create -d "Fresh install of Foxtail" --cleanup-algorithm number

systemctl enable sddm NetworkManager bluetooth systemd-timesyncd grub-btrfsd snapper-cleanup.timer >/dev/null 2>&1 || true
CHROOT

# Password is set outside the heredoc so it never lands in a shell history or argv.
printf '%s:%s\n' "$FT_USER" "$FT_PASS" | arch-chroot "$TARGET" chpasswd

progress 97 "Finishing up…"
sync
umount -R "$TARGET"
progress 100 "Foxtail is installed."
