[Desktop Entry]
Name=Terminal
Name[de]=Terminal
Name[fr]=Terminal
Name[es]=Terminal
Comment=Use the command line
Exec=foxtail-terminal
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;cmd;console;
StartupNotify=true
X-ExecArg=-e
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=foxtail-terminal
