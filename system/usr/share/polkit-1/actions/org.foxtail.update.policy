<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Friendly password prompts for Foxtail's privileged helpers. -->
<policyconfig>
  <vendor>Foxtail OS</vendor>
  <action id="org.foxtail.update">
    <description>Install software updates</description>
    <message>System Settings wants to install software updates.</message>
    <icon_name>foxtail</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/foxtail-update</annotate>
  </action>
  <action id="org.foxtail.restore">
    <description>Restore a previous version of Foxtail</description>
    <message>System Settings wants to restore your system to an earlier snapshot.</message>
    <icon_name>foxtail</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/foxtail-restore</annotate>
  </action>
  <action id="org.foxtail.users">
    <description>Manage user accounts</description>
    <message>System Settings wants to make changes to user accounts.</message>
    <icon_name>foxtail</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/foxtail-users</annotate>
  </action>
  <action id="org.foxtail.channel">
    <description>Change the update channel</description>
    <message>System Settings wants to change where Foxtail gets its updates.</message>
    <icon_name>foxtail</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/foxtail-channel</annotate>
  </action>
</policyconfig>
